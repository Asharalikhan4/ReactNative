{
  "name": "reactnativeexpo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.19",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "clean": "expo prebuild --clean",
    "build": "expo prebuild",
    "build-android": "expo prebuild --platform android",
    "build-ios": "expo prebuild --platform ios",
    "android-testing-build-eas-cloud": "npx eas-cli build --platform android --profile preview",
    "android-testing-build-eas-local": "npx eas-cli build --platform android --profile preview --local",
    "ios-testing-build-eas-cloud": "npx eas-cli build --platform ios --profile preview",
    "ios-testing-build-eas-local": "npx eas-cli build --platform ios --profile simulator",
    "android-production-build-eas-cloud": "npx eas-cli build --platform android --profile production",
    "android-production-build-eas-local": "npx eas-cli build --platform android --profile production --local",
    "ios-production-build-eas-cloud": "npx eas-cli build --platform ios --profile production",
    "ios-production-build-eas-local": "npx eas-cli build --platform ios --profile production --local",
    "android-testing-apk-build-local": "expo prebuild --clean --platform android && cd android && ./gradlew assembleDebug",
    "android-production-apk-build-local": "expo prebuild --clean --platform android && cd android && ./gradlew assembleRelease",
    "android-production-aab-build-local": "expo prebuild --clean --platform android && cd android && ./gradlew bundleRelease"
  },
  "private": true
}
